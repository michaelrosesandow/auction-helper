{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/heads/main/npm/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "import", "oxc", "promise", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "style": "warn",
    "perf": "warn"
  },
  "rules": {
    "curly": "error",
    "eqeqeq": "error",
    "no-implicit-coercion": "error",
    "no-throw-literal": "error",
    "no-var": "error",
    "no-new-wrappers": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-assertions": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-nodejs-modules": "off",
    "import/no-named-export": "off",
    "import/group-exports": "off",
    "sort-imports": "off",
    "no-ternary": "off",
    "init-declarations": "off",
    "func-style": "off",
    "no-magic-numbers": "off",
    "capitalized-comments": "off",
    "typescript/no-implied-eval": "off",
    "typescript/prefer-promise-reject-errors": "off",
    "typescript/require-await": "off",
    "typescript/prefer-includes": "off",
    "typescript/prefer-string-starts-ends-with": "off",
    "unicorn/no-lonely-if": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/consistent-function-scoping": "error",
    "max-lines": [
      "error",
      {
        "max": 900,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity": ["warn", { "max": 20 }],
    "max-params": ["warn", { "max": 6 }],
    "max-depth": ["warn", { "max": 5 }],
    "max-statements": ["warn", { "max": 40 }],
    "max-lines-per-function": [
      "warn",
      {
        "max": 150,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-nested-callbacks": ["warn", { "max": 4 }],
    "vitest/require-hook": "off",
    "unicorn/prefer-top-level-await": "off",
    "import/consistent-type-specifier-style": "off",
    "import/exports-last": "off",
    "eslint/sort-keys": "off",
    "eslint/id-length": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-continue": "off",
    "eslint/prefer-destructuring": "off",
    "eslint/require-await": "off",
    "eslint/require-unicode-regexp": "off",
    "eslint/no-duplicate-imports": "off",
    "unicorn/prefer-string-replace-all": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-null": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/no-nested-ternary": "off",
    "promise/prefer-await-to-then": "off",
    "promise/always-return": "off",
    "vitest/prefer-expect-assertions": "off",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/prefer-describe-function-title": "off",
    "vitest/prefer-to-have-length": "off",
    "vitest/prefer-strict-equal": "off",
    "vitest/prefer-to-be-truthy": "off",
    "vitest/prefer-to-be-falsy": "off"
  },
  "overrides": [
    {
      "files": ["build.mjs"],
      "rules": {
        "node/no-sync": "off",
        "import/no-namespace": "off",
        "eslint/sort-keys": "off"
      }
    },
    {
      "files": ["src/types.ts"],
      "rules": {
        "eslint/id-length": "off",
        "eslint/sort-keys": "off"
      }
    },
    {
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "max-nested-callbacks": "off",
        "max-statements": "off",
        "max-lines-per-function": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "warn",
        "vitest/valid-expect": "error"
      }
    }
  ],
  "env": { "browser": true, "node": true },
  "options": { "reportUnusedDisableDirectives": "warn" }
}
